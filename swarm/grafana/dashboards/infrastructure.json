{
    "title": "Infrastructure",
    "uid": "infra",
    "schemaVersion": 39,
    "panels": [
        {
            "title": "CPU Usage",
            "type": "timeseries",
            "targets": [
                {
                    "datasource": {
                        "uid": "prometheus"
                    },
                    "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))*100"
                }
            ]
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "targets": [
                {
                    "datasource": {
                        "uid": "prometheus"
                    },
                    "expr": "node_memory_MemTotal_bytes-node_memory_MemAvailable_bytes"
                }
            ]
        },
        {
            "title": "Disk Usage",
            "type": "timeseries",
            "targets": [
                {
                    "datasource": {
                        "uid": "prometheus"
                    },
                    "expr": "node_filesystem_size_bytes-node_filesystem_free_bytes"
                }
            ]
        }
    ]
}