// =============================================================================
// Docker container logs — nginx, mongo, mongo-express, meilisearch,
// prometheus, grafana, loki, tempo, and memoize are all picked up
// automatically via the Docker socket. memoize is explicitly dropped below
// because it's captured separately (and better) via the structured-file
// pipeline further down — without the drop rule you'd get every backend log
// line twice.
// =============================================================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = "memoize"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

// =============================================================================
// memoize backend's structured Pino log file.
//
// Requires the SAME host folder bind-mounted into both services:
//   memoize:  - ./memoize_logs:/app/logs:rw (LOG_DIR=/app/logs)
//   alloy:    - ./memoize_logs:/var/log/memoize:ro
// =============================================================================
local.file_match "memoize_backend" {
  path_targets = [
    {
      __path__ = "/var/log/memoize/*.log",
      job      = "memoize-backend",
    },
  ]
}

loki.source.file "memoize_backend" {
  targets    = local.file_match.memoize_backend.targets
  forward_to = [loki.process.memoize_backend.receiver]
}

loki.process "memoize_backend" {
  forward_to = [loki.write.default.receiver]

  // Pino writes one JSON object per line. Pull a couple of fields out as
  // labels and use the log's own timestamp instead of the time Alloy read
  // the line, so log lines land on the Grafana timeline where they actually
  // happened, not when Alloy happened to catch up.
  stage.json {
    expressions = {
      level = "level",
      time  = "time",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.timestamp {
    source = "time"
    format = "UnixMs"
  }
}

// =============================================================================
// Host metrics — replaces a standalone node-exporter container. Uses the
// exact same collector code node_exporter does, so no metrics are lost.
// Requires these mounts on the alloy service (already in your compose):
//   /proc:/host/proc:ro
//   /sys:/host/sys:ro
//   /:/rootfs:ro
//
// Scraped directly by Prometheus (pull-based, no remote_write needed) at:
//   alloy:12345/api/v0/component/prometheus.exporter.unix.host/metrics
// =============================================================================
prometheus.exporter.unix "host" {
  rootfs_path = "/rootfs"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
}

// =============================================================================
// OTLP receiver — accepts traces exported by the memoize backend (or any
// other service you instrument later) via OpenTelemetry, batches them, and
// forwards to Tempo. NOT published on any host port — only reachable over
// backend_net, which the memoize service needs to be attached to alongside
// this alloy service (see docker-compose.yml).
//
// 0.0.0.0 is required, not localhost — Alloy's default binds to localhost,
// which would make it unreachable from the memoize container.
// =============================================================================
otelcol.receiver.otlp "backend" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout         = "5s"
  send_batch_size = 1024

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      // Plain internal Docker network traffic, no certs configured on Tempo's side.
      insecure = true
    }
  }
}

// =============================================================================
// Single shared writer to Loki
// =============================================================================
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Alloy's own internal logs (component errors, pipeline health) — printed to
// its container stdout, so `docker logs alloy` stays useful for debugging
// this config itself.
logging {
  level  = "info"
  format = "logfmt"
}