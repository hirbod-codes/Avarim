NODE_ENV=development

LOG_LEVEL=info # trace|debug|info|warn|error|fatal
LOG_DIR=./logs # dev: relative folder. prod: absolute path matching the bind mount you give the monitoring stack's Alloy container
VIDEO_UPLOAD_TMP_DIR=./video_tmp/
AUDIO_UPLOAD_TMP_DIR=./audio_tmp/
IMAGE_UPLOAD_TMP_DIR=./image_tmp/

OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
LOKI_PUSH_URL=http://loki:3100
PUSHGATEWAY_URL=http://pushgateway:9091

HOST=0.0.0.0
PORT=3000

APP_URL=domain.tld

# Only one value (and not *) is allowed by browsers when httpOnly cookies are used
# Set to the nginx proxy port in development environment
ALLOWED_ORIGINS=https://localhost:8081

DB_DATABASE_NAME=Avarim
DB_SUPPORTS_TRANSACTION=false
DB_URL=mongodb://localhost:27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE_INDEX=0
REDIS_SUPPORTS_TRANSACTION=
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=

# For the cloud storage
STREAM_SIGNING_SECRET=very_secret

ACCESS_TOKEN_SECRET=very_secret
REFRESH_TOKEN_SECRET=very_secret

TTS_API_KEY=very_secret

MEILISEARCH_KEY=very_secret
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700

BUCKET_NAME=example
S3_STORAGE_ENDPOINT=example.domain.tld
S3_STORAGE_ACCESS_KEY=secret
S3_STORAGE_PRIVATE_KEY=secret

SMS_PROVIDER_IDENTIFIER=melipayamak

# melipayamak
MELIPAYAMAK_BASE_ENDPOINT=https://sms_provider.tld/api/
MELIPAYAMAK_USERNAME=admin
MELIPAYAMAK_API_KEY=secret
MELIPAYAMAK_FROM=0556520...
MELIPAYAMAK_VERIFICATION_MESSAGE_REFERENCE_ADDRESS=example.tld

# comma separated list of supported payment methods
SUPPORTED_PAYMENT_METHODS=zarinpal,zibal

# zarinpal
ZARINPAL_URL=https://payment.zarinpal.com
ZARINPAL_MERCHANT_ID=1111111111111

ZIBAL_URL=https://gateway.zibal.ir
ZIBAL_MERCHANT_ID=1111111111111
