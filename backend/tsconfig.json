{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowJs": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "inlineSourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist", // Output directory
        "rootDir": "./src", // Source directory
        "typeRoots": [
            "./node_modules/@types",
            "./src/types"
        ]
    },
    "include": [
        "src/*",
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ] // Exclude dist folder to prevent watching the compiled files
}